<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PCL2UnlockPatcher</AssemblyName>
    <RootNamespace>PCL2UnlockPatcher</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>PCL2 官方版解锁补丁器</AssemblyTitle>
    <AssemblyProduct>PCL2UnlockPatcher</AssemblyProduct>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="dnlib">
      <HintPath>dnlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <EmbeddedResource Include="dnlib.dll" LogicalName="PCL2Unlock.dnlib.dll" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="donor.deflate" />
  </ItemGroup>

</Project>
